---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '../config';
import { HTML_LANG, OG_LOCALE, type Lang } from '../i18n';
import { withBase } from '../lib/urls';

export interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Root-relative paths without base, e.g. { de: '/karte/', en: '/en/map/' } */
  alternates: Partial<Record<Lang, string>>;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  jsonLd?: object[];
  noindex?: boolean;
}

const { title, description, lang, alternates, image, imageAlt, type = 'website', published, modified, jsonLd = [], noindex = false } = Astro.props;

const abs = (p: string) => new URL(withBase(p), Astro.site).href;
const canonical = abs(alternates[lang] ?? '/');
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;

let ogImage = abs('/og-default.jpg');
let ogW = 1200;
let ogH = 630;
if (image) {
  const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
  ogImage = new URL(og.src, Astro.site).href;
}
const robots = noindex || !SITE.indexing ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1';
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
{Object.entries(alternates).map(([l, p]) => <link rel="alternate" hreflang={HTML_LANG[l as Lang]} href={abs(p!)} />)}
{alternates.de && <link rel="alternate" hreflang="x-default" href={abs(alternates.de)} />}

<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={OG_LOCALE[lang]} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(ogW)} />
<meta property="og:image:height" content={String(ogH)} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{published && <meta property="article:published_time" content={published.toISOString()} />}
{modified && <meta property="article:modified_time" content={modified.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />

{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
