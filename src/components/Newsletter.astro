---
import { SITE } from '../config';
import { t, type Lang } from '../i18n';
import { route } from '../lib/urls';

interface Props { lang: Lang; variant?: 'band' | 'inline' }
const { lang, variant = 'band' } = Astro.props;
const ui = t(lang);
const configured = Boolean(SITE.newsletterAction);
---

<section class:list={['newsletter', `newsletter--${variant}`]} aria-labelledby={`nl-${variant}`}>
  <div class="wrap newsletter__inner">
    <div>
      <p class="kicker">{ui.newsletter}</p>
      <h2 id={`nl-${variant}`}>{ui.nlTitle}</h2>
      <p class="newsletter__text">{ui.nlText}</p>
    </div>
    <form
      class="newsletter__form"
      method="post"
      action={configured ? SITE.newsletterAction : undefined}
      target={configured ? '_blank' : undefined}
      data-newsletter={configured ? 'live' : 'soon'}
      data-soon={ui.nlSoon}
    >
      <label class="sr-only" for={`nl-email-${variant}`}>{ui.nlPlaceholder}</label>
      <div class="newsletter__row">
        <input class="input" id={`nl-email-${variant}`} type="email" name={SITE.newsletterEmailField} placeholder={ui.nlPlaceholder} autocomplete="email" required />
        <button class="btn" type="submit">{ui.nlButton}</button>
      </div>
      <p class="newsletter__legal">{ui.nlConsent} <a href={route('privacy', lang)}>{ui.privacy}</a>.</p>
      <p class="newsletter__status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .newsletter--band { background: var(--paper); border-block: 1px solid var(--line); }
  .newsletter__inner {
    display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: end;
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  h2 { font-size: var(--step-3); margin-top: 0.75rem; }
  .newsletter__text { color: var(--muted); margin-top: 1rem; max-width: 34rem; }
  .newsletter__row { display: flex; gap: 0.5rem; }
  .newsletter__row .input { flex: 1; min-width: 0; }
  .newsletter__legal { font-size: 0.8rem; color: var(--muted); margin-top: 0.75rem; }
  .newsletter__status { font-size: 0.95rem; margin-top: 0.75rem; color: var(--accent-ink); }
  .newsletter__status:empty { display: none; }
  @media (max-width: 820px) {
    .newsletter__inner { grid-template-columns: 1fr; }
  }
  @media (max-width: 460px) {
    .newsletter__row { flex-direction: column; }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-newsletter="soon"]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const status = form.querySelector('.newsletter__status');
      if (status) status.textContent = form.dataset.soon ?? '';
    });
  });
</script>
