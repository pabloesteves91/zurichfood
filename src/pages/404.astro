---
import Base from '../layouts/Base.astro';
import { route } from '../lib/urls';
---
<Base lang="de" title="Seite nicht gefunden" description="Diese Seite gibt es nicht (mehr)." alternates={{}} noindex>
  <section class="wrap section" style="text-align:center;min-height:55vh;display:grid;place-content:center;gap:1.25rem;justify-items:center">
    <p class="kicker">404</p>
    <h1 style="font-size:var(--step-5)">Hier gibt’s nichts zu essen.</h1>
    <p class="lead" style="color:var(--muted)">Die Seite wurde verschoben oder existiert nicht. · This page doesn’t exist.</p>
    <div style="display:flex;gap:.75rem;flex-wrap:wrap;justify-content:center">
      <a class="btn" href={route('home', 'de')}>Zur Startseite</a>
      <a class="btn btn--ghost" href={route('search', 'de')}>Suche</a>
      <a class="btn btn--ghost" href={route('home', 'en')}>English</a>
    </div>
  </section>
</Base>
