---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Newsletter from '../components/Newsletter.astro';
import sisters from '../assets/brand/laura-eva-wick.jpg';
import { SITE } from '../config';
import { CATEGORIES, CATEGORY_META, ROUTES, t, type Lang } from '../i18n';
import { formatDate, getPosts, joinNames } from '../lib/posts';
import { categoryUrl, postUrl, route } from '../lib/urls';
import { website } from '../lib/schema';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const posts = await getPosts(lang);
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const latest = posts.filter((p) => p !== featured).slice(0, 6);
const counts = Object.fromEntries(CATEGORIES.map((c) => [c, posts.filter((p) => p.data.category === c).length]));
const places = await getCollection('places');
const areas = [...new Set(places.map((p) => p.data.area))];

const copy = {
  de: {
    title: 'Zürich Food – Die besten Restaurants, Hotels & Erlebnisse in Zürich',
    description: 'Die besten Restaurants, Cafés, Hotels, Concept-Stores und Erlebnisse in Zürich und der Schweiz. Ehrlich empfohlen von Laura & Eva Wick (@zurich.food).',
    h1a: 'Die besten Adressen',
    h1b: 'in Zürich & der Schweiz',
    intro: 'Restaurants, Hotels, Stores und Erlebnisse, selbst besucht und ehrlich empfohlen von zwei Schwestern.',
    sections: 'Rubriken',
    mapTitle: 'Alle Adressen auf einer Karte',
    mapText: 'Filtere nach Kreis, Küche und Preis und finde deinen nächsten Lieblingsort.',
    mapCta: 'Karte öffnen',
    addresses: 'Adressen',
    aboutQuote: 'Was als Tagebuch für unsere Food-Erinnerungen begann, ist zu einer festen Adresse in Zürich geworden.',
    aboutCta: 'Mehr über uns',
    since: `Seit ${SITE.since} auf Instagram`,
  },
  en: {
    title: 'Zürich Food – The Best Restaurants, Hotels & Things to Do in Zurich',
    description: 'The best restaurants, cafés, hotels, concept stores and experiences in Zurich and Switzerland. Honestly recommended by Laura & Eva Wick (@zurich.food).',
    h1a: 'The best addresses',
    h1b: 'in Zurich & Switzerland',
    intro: 'Restaurants, hotels, stores and experiences, visited in person and honestly recommended by two sisters.',
    sections: 'Sections',
    mapTitle: 'Every address on one map',
    mapText: 'Filter by district, cuisine and price, and find your next favourite place.',
    mapCta: 'Open the map',
    addresses: 'addresses',
    aboutQuote: 'What started as a diary of our food memories has become a go-to address in Zurich.',
    aboutCta: 'More about us',
    since: `On Instagram since ${SITE.since}`,
  },
}[lang];
---

<Base
  lang={lang}
  title={copy.title}
  description={copy.description}
  alternates={{ de: ROUTES.home.de, en: ROUTES.home.en }}
  jsonLd={[website(Astro.site, import.meta.env.BASE_URL, lang)]}
>
  <section class="wrap hero-intro">
    <p class="kicker">{SITE.tagline[lang]}</p>
    <h1><span>{copy.h1a}</span> <em>{copy.h1b}</em></h1>
    <p class="lead">{copy.intro}</p>
  </section>

  {featured && (
    <section class="wrap featured" aria-labelledby="featured-title">
      <a class="featured__media" href={postUrl(featured)} tabindex="-1" aria-hidden="true">
        <Image src={featured.data.image} alt={featured.data.imageAlt} widths={[640, 900, 1200]} sizes="(max-width: 860px) 100vw, 58vw" loading="eager" fetchpriority="high" />
      </a>
      <div class="featured__body">
        <p class="kicker">{ui.featured} · {CATEGORY_META[featured.data.category].name[lang]}</p>
        <h2 id="featured-title"><a href={postUrl(featured)}>{featured.data.title}</a></h2>
        <p class="lead">{featured.data.description}</p>
        <p class="meta">{ui.by} {joinNames(featured.data.authors, ui.and)} · {formatDate(featured.data.date, lang)}</p>
        <a class="btn btn--ghost" href={postUrl(featured)}>{ui.readMore}</a>
      </div>
    </section>
  )}

  {latest.length > 0 && (
    <section class="wrap section" aria-labelledby="latest-title">
      <div class="section-head">
        <h2 id="latest-title">{ui.latest}</h2>
        <a href={route('search', lang)}>{ui.allPosts}</a>
      </div>
      <div class="grid grid--3">
        {latest.map((p) => <PostCard post={p} />)}
      </div>
    </section>
  )}

  <section class="wrap section section--tight" aria-labelledby="sections-title">
    <div class="section-head"><h2 id="sections-title">{copy.sections}</h2></div>
    <ol class="cats">
      {CATEGORIES.map((c, i) => (
        <li class="reveal">
          <a href={categoryUrl(c, lang)} class="cat">
            <span class="cat__num">0{i + 1}</span>
            <span class="cat__name">{CATEGORY_META[c].name[lang]}</span>
            <span class="cat__text">{CATEGORY_META[c].short[lang]}</span>
            <span class="cat__count">{counts[c] ? `${counts[c]} ${counts[c] === 1 ? (lang === 'de' ? 'Beitrag' : 'story') : (lang === 'de' ? 'Beiträge' : 'stories')}` : ui.comingSoon} →</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="section map-teaser" aria-labelledby="map-title">
    <div class="wrap map-teaser__inner">
      <div class="reveal">
        <p class="map-teaser__num">{places.length}</p>
        <p class="kicker">{copy.addresses}</p>
      </div>
      <div class="reveal">
        <h2 id="map-title">{copy.mapTitle}</h2>
        <p class="map-teaser__text">{copy.mapText}</p>
        <ul class="map-teaser__areas">{areas.map((a) => <li>{a}</li>)}</ul>
        <a class="btn" href={route('map', lang)}>{copy.mapCta}</a>
      </div>
    </div>
  </section>

  <section class="wrap section about-teaser" aria-labelledby="about-title">
    <div class="about-teaser__media reveal">
      <Image src={sisters} alt={lang === 'de' ? 'Laura Wick und Eva Wick von Zürich Food' : 'Laura Wick and Eva Wick of Zürich Food'} widths={[400, 640]} sizes="(max-width: 760px) 80vw, 420px" />
    </div>
    <div class="reveal">
      <p class="kicker" id="about-title">{ui.about} · {copy.since}</p>
      <blockquote><p>«{copy.aboutQuote}»</p></blockquote>
      <p class="meta">Laura &amp; Eva Wick</p>
      <a class="btn btn--ghost" href={route('about', lang)}>{copy.aboutCta}</a>
    </div>
  </section>

  <Newsletter lang={lang} />
</Base>

<style>
  .hero-intro { text-align: center; padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3.5rem); }
  .hero-intro h1 { font-size: var(--step-5); margin-top: 1rem; line-height: 1.02; }
  .hero-intro h1 span, .hero-intro h1 em { display: block; }
  .hero-intro h1 em { color: var(--accent); }
  .hero-intro .lead { max-width: 36rem; margin: 1.5rem auto 0; color: var(--muted); }

  .featured {
    display: grid; grid-template-columns: 1.35fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center;
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }
  .featured__media { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--paper); }
  .featured__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
  .featured__media:hover img { transform: scale(1.03); }
  .featured__body { display: grid; gap: 1.25rem; justify-items: start; }
  .featured__body h2 { font-size: var(--step-4); }
  .featured__body h2 a { text-decoration: none; }
  .featured__body .lead { color: var(--muted); }

  .cats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); }
  .cats li + li { border-left: 1px solid var(--line); }
  .cat { display: grid; gap: 0.6rem; padding: 0.5rem clamp(1rem, 2vw, 1.75rem) 1.5rem; text-decoration: none; height: 100%; }
  .cats li:first-child .cat { padding-left: 0; }
  .cat__num { font-size: 0.8rem; color: var(--accent); font-variant-numeric: tabular-nums; }
  .cat__name { font-family: var(--serif); font-size: var(--step-3); line-height: 1.1; transition: color 0.2s; }
  .cat:hover .cat__name { color: var(--accent); }
  .cat__text { color: var(--muted); font-size: 0.95rem; }
  .cat__count { font-size: 0.82rem; font-weight: 500; margin-top: auto; padding-top: 0.75rem; }

  .map-teaser { background: var(--text); color: var(--bg); }
  .map-teaser__inner { display: grid; grid-template-columns: 1fr 1.4fr; gap: 3rem; align-items: end; }
  .map-teaser__num { font-family: var(--serif); font-size: clamp(6rem, 4rem + 10vw, 13rem); line-height: 0.85; color: #c8a868; }
  .map-teaser .kicker { color: #c8a868; margin-top: 1rem; }
  .map-teaser h2 { font-size: var(--step-4); }
  .map-teaser__text { color: #c9c3b8; margin-top: 1rem; max-width: 32rem; }
  .map-teaser__areas { list-style: none; padding: 0; margin: 1.5rem 0 2rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .map-teaser__areas li { border: 1px solid #4a4741; border-radius: 999px; padding: 0.3rem 0.85rem; font-size: 0.82rem; color: #e4dfd6; }
  .map-teaser .btn { background: var(--bg); color: var(--text); border-color: var(--bg); }
  .map-teaser .btn:hover { background: #c8a868; border-color: #c8a868; color: var(--text); }

  .about-teaser { display: grid; grid-template-columns: minmax(0, 420px) 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .about-teaser__media { aspect-ratio: 2 / 3; overflow: hidden; }
  .about-teaser__media img { width: 100%; height: 100%; object-fit: cover; }
  .about-teaser blockquote { margin: 1.5rem 0 1rem; }
  .about-teaser blockquote p { font-family: var(--serif); font-size: var(--step-3); line-height: 1.25; font-style: italic; }
  .about-teaser .btn { margin-top: 2rem; }

  @media (max-width: 960px) {
    .cats { grid-template-columns: 1fr 1fr; }
    .cats li:nth-child(3) { border-left: 0; }
    .cats li:nth-child(3) .cat { padding-left: 0; }
    .cats li:nth-child(n + 3) { border-top: 1px solid var(--line); padding-top: 1rem; }
  }
  @media (max-width: 860px) {
    .featured, .map-teaser__inner { grid-template-columns: 1fr; }
    .featured__media { aspect-ratio: 4 / 5; margin-inline: calc(-1 * var(--gutter)); }
  }
  @media (max-width: 760px) {
    .about-teaser { grid-template-columns: 1fr; }
    .about-teaser__media { max-width: 360px; }
  }
  @media (max-width: 520px) {
    .cats { grid-template-columns: 1fr; }
    .cats li + li { border-left: 0; border-top: 1px solid var(--line); padding-top: 1rem; }
    .cats .cat { padding-left: 0; }
  }
</style>
