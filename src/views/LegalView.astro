---
import Base from '../layouts/Base.astro';
import { ROUTES, type Lang } from '../i18n';

interface Props { lang: Lang; page: 'imprint' | 'privacy'; title: string; description: string }
const { lang, page, title, description } = Astro.props;
---

<Base lang={lang} title={title} description={description} alternates={{ de: ROUTES[page].de, en: ROUTES[page].en }}>
  <article class="wrap wrap--read legal">
    <h1>{title}</h1>
    <div class="prose"><slot /></div>
  </article>
</Base>

<style>
  .legal { padding-block: clamp(3rem, 7vw, 5rem) 6rem; }
  h1 { font-size: var(--step-5); margin-bottom: 2.5rem; }
  .legal .prose > p:first-of-type::first-letter { all: unset; }
  .legal .prose h2 { font-size: var(--step-2); margin-top: 2em; }
</style>
