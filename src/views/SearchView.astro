---
import Base from '../layouts/Base.astro';
import { ROUTES, t, type Lang } from '../i18n';
import { withBase } from '../lib/urls';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const copy = {
  de: {
    title: 'Suche',
    description: 'Durchsuche alle Beiträge von Zürich Food: Restaurants, Cafés, Hotels, Stores und Erlebnisse in Zürich.',
    placeholder: 'Restaurant, Quartier, Gericht …',
    hint: 'Zum Beispiel: Brunch, Kreis 4, Tessin, Fondue',
    none: 'Keine Treffer. Versuch es mit einem anderen Begriff.',
    found: (n: number) => `${n} ${n === 1 ? 'Treffer' : 'Treffer'}`,
  },
  en: {
    title: 'Search',
    description: 'Search every Zürich Food story: restaurants, cafés, hotels, stores and things to do in Zurich.',
    placeholder: 'Restaurant, neighbourhood, dish …',
    hint: 'For example: brunch, fine dining, Ticino, fondue',
    none: 'No results. Try a different word.',
    found: (n: number) => `${n} ${n === 1 ? 'result' : 'results'}`,
  },
}[lang];
---

<Base lang={lang} title={copy.title} description={copy.description} alternates={{ de: ROUTES.search.de, en: ROUTES.search.en }}>
  <section class="wrap wrap--read search">
    <h1>{copy.title}</h1>
    <form role="search" class="search__form" data-search data-base={withBase('/pagefind/')} data-none={copy.none} data-one={copy.found(1)} data-many={copy.found(2).replace('2', '{n}')}>
      <label class="sr-only" for="q">{ui.search}</label>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
      <input id="q" name="q" type="search" placeholder={copy.placeholder} autocomplete="off" autofocus />
    </form>
    <p class="meta search__hint" data-status aria-live="polite">{copy.hint}</p>
    <ol class="search__results" data-results></ol>
  </section>
</Base>

<style>
  .search { padding-block: clamp(3rem, 7vw, 5rem) 6rem; min-height: 60vh; }
  h1 { font-size: var(--step-5); }
  .search__form { display: flex; align-items: center; gap: 0.75rem; border-bottom: 1px solid var(--text); margin-top: 2rem; padding-bottom: 0.5rem; }
  .search__form input { flex: 1; min-width: 0; border: 0; background: none; font-family: var(--serif); font-size: var(--step-2); padding: 0.5rem 0; color: var(--text); }
  .search__form input:focus { outline: none; }
  .search__form input::-webkit-search-cancel-button { appearance: none; }
  .search__hint { margin-top: 1rem; }
  .search__results { list-style: none; margin: 2rem 0 0; padding: 0; }
  .search__results :global(li) { border-bottom: 1px solid var(--line); }
  .search__results :global(a) { display: grid; grid-template-columns: 96px 1fr; gap: 1.25rem; padding-block: 1.5rem; text-decoration: none; }
  .search__results :global(img) { width: 96px; height: 120px; object-fit: cover; background: var(--paper); }
  .search__results :global(.r-title) { font-family: var(--serif); font-size: var(--step-2); line-height: 1.2; margin-top: 0.3rem; }
  .search__results :global(.r-excerpt) { color: var(--muted); font-size: 0.95rem; margin-top: 0.5rem; }
  .search__results :global(mark) { background: var(--gold-soft); color: inherit; padding: 0 0.1em; }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-search]')!;
  const input = form.querySelector<HTMLInputElement>('input')!;
  const list = document.querySelector<HTMLOListElement>('[data-results]')!;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const hint = status.textContent;
  let pagefind: any;

  async function load() {
    if (!pagefind) {
      try {
        // Load Pagefind at runtime; bypass Vite's import rewriting.
        const load = new Function('u', 'return import(u)') as (u: string) => Promise<any>;
        pagefind = await load(`${form.dataset.base}pagefind.js`);
        await pagefind.options({ excerptLength: 24 });
      } catch {
        status.textContent = 'Search index not available in dev mode – run npm run build.';
        return null;
      }
    }
    return pagefind;
  }

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  let token = 0;
  async function run(q: string) {
    const my = ++token;
    const url = new URL(location.href);
    q ? url.searchParams.set('q', q) : url.searchParams.delete('q');
    history.replaceState(null, '', url);
    if (!q.trim()) { list.innerHTML = ''; status.textContent = hint; return; }
    const pf = await load();
    if (!pf) return;
    const search = await pf.debouncedSearch(q, {}, 200);
    if (search === null || my !== token) return;
    const data = await Promise.all(search.results.slice(0, 20).map((r: any) => r.data()));
    if (my !== token) return;
    const n = search.results.length;
    status.textContent = n === 0 ? form.dataset.none! : n === 1 ? form.dataset.one! : form.dataset.many!.replace('{n}', String(n));
    list.innerHTML = data
      .map((d: any) => `<li><a href="${d.url}">${d.meta.image ? `<img src="${d.meta.image}" alt="" loading="lazy">` : '<span></span>'}<div><p class="kicker">${esc(d.meta.category ?? '')}</p><p class="r-title">${esc(d.meta.title ?? '')}</p><p class="r-excerpt">${d.excerpt}</p></div></a></li>`)
      .join('');
  }

  input.addEventListener('input', () => run(input.value));
  form.addEventListener('submit', (e) => { e.preventDefault(); run(input.value); });
  const initial = new URLSearchParams(location.search).get('q');
  if (initial) { input.value = initial; run(initial); }
</script>
