---
import { Image, getImage } from 'astro:assets';
import { getEntries, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE } from '../config';
import { CATEGORY_META, HTML_LANG, ROUTES, t } from '../i18n';
import { formatDate, getPosts, getTranslation, joinNames, readingTime, type Post } from '../lib/posts';
import { absolute, categoryUrl, postLang, postPath, postUrl, route, withBase } from '../lib/urls';
import { breadcrumbs, faqPage, organization, placeSchema } from '../lib/schema';

interface Props { post: Post }
const { post } = Astro.props;
const lang = postLang(post);
const ui = t(lang);
const { Content } = await render(post);
const d = post.data;
const cat = CATEGORY_META[d.category];
const places = d.places.length ? await getEntries(d.places) : [];
const translation = await getTranslation(post);
const related = (await getPosts(lang)).filter((p) => p.id !== post.id).sort((a, b) => Number(b.data.category === d.category) - Number(a.data.category === d.category)).slice(0, 3);
const minutes = readingTime(post.body);
const url = absolute(postUrl(post), Astro.site);
const mapUrl = route('map', lang);
const ogImage = await getImage({ src: d.image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const squareImage = await getImage({ src: d.image, width: 1200, height: 1200, fit: 'cover', format: 'jpg', quality: 82 });

const alternates = { [lang]: postPath(post), ...(translation ? { [postLang(translation)]: postPath(translation) } : {}) };

const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.seoTitle ?? d.title,
  description: d.description,
  image: [absolute(ogImage.src, Astro.site), absolute(squareImage.src, Astro.site)],
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  inLanguage: HTML_LANG[lang],
  author: d.authors.map((name) => ({ '@type': 'Person', name, url: absolute(route('about', lang), Astro.site) })),
  publisher: organization(Astro.site, import.meta.env.BASE_URL),
  mainEntityOfPage: url,
  articleSection: cat.name[lang],
  ...(places.length ? { about: places.map((p) => placeSchema(p.data)) } : {}),
};
const jsonLd: object[] = [
  article,
  breadcrumbs([
    { name: ui.home, url: absolute(withBase(ROUTES.home[lang]), Astro.site) },
    { name: cat.name[lang], url: absolute(categoryUrl(d.category, lang), Astro.site) },
    { name: d.title, url },
  ]),
];
if (d.faq.length) jsonLd.push(faqPage(d.faq));
const hero = d.image;
---

<Base
  lang={lang}
  title={d.seoTitle ?? d.title}
  description={d.description}
  alternates={alternates}
  image={hero}
  imageAlt={d.imageAlt}
  type="article"
  published={d.date}
  modified={d.updated ?? d.date}
  jsonLd={jsonLd}
>
  <article data-pagefind-body>
    <header class="wrap post-head">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href={route('home', lang)}>{ui.home}</a></li>
          <li><a href={categoryUrl(d.category, lang)}>{cat.name[lang]}</a></li>
        </ol>
      </nav>
      <a class="kicker" href={categoryUrl(d.category, lang)} data-pagefind-meta="category">{cat.name[lang]}</a>
      <h1>{d.title}</h1>
      <p class="lead">{d.description}</p>
      <p class="meta">
        {ui.by} {joinNames(d.authors, ui.and)} ·
        <time datetime={d.date.toISOString()}>{formatDate(d.date, lang)}</time>
        {d.updated && <> · {ui.updated} <time datetime={d.updated.toISOString()}>{formatDate(d.updated, lang)}</time></>}
        · {minutes} {ui.minRead}
      </p>
    </header>

    <figure class="post-hero">
      <Image src={hero} alt={d.imageAlt} widths={[640, 960, 1400, 1800]} sizes="(max-width: 1240px) 100vw, 1240px" loading="eager" fetchpriority="high" data-pagefind-meta="image[src]" />
    </figure>

    <div class="wrap wrap--read">
      {d.disclosure && (
        <aside class="disclosure"><strong>{ui.disclosure}:</strong> {d.disclosure}</aside>
      )}
      <div class="prose">
        <Content />
      </div>

      {places.length > 0 && (
        <section class="places" aria-labelledby="places-title">
          <h2 id="places-title">{ui.places}</h2>
          <ul>
            {places.map((p) => (
              <li class="place" id={p.id}>
                <div class="place__head">
                  <h3>{p.data.name}</h3>
                  {p.data.price && <span class="place__price" title={ui.priceLevels[p.data.price - 1]}>{'$'.repeat(p.data.price)}</span>}
                </div>
                <p class="place__summary">{p.data.summary[lang]}</p>
                <dl>
                  <div><dt>{ui.address}</dt><dd>{p.data.street}, {p.data.postalCode} {p.data.city}</dd></div>
                  {p.data.phone && <div><dt>{ui.phone}</dt><dd><a href={`tel:${p.data.phone.replace(/\s/g, '')}`}>{p.data.phone}</a></dd></div>}
                  {p.data.website && <div><dt>{ui.website}</dt><dd><a href={p.data.website} rel="noopener" target="_blank">{new URL(p.data.website).hostname.replace('www.', '')}</a></dd></div>}
                  {p.data.award && <div><dt>{ui.award}</dt><dd>{p.data.award}</dd></div>}
                </dl>
                <p class="place__links">
                  <a href={`${mapUrl}?place=${p.id}`}>{ui.showOnMap}</a>
                  <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${p.data.name}, ${p.data.street}, ${p.data.postalCode} ${p.data.city}`)}`} rel="noopener" target="_blank">{ui.route} ↗</a>
                </p>
              </li>
            ))}
          </ul>
        </section>
      )}

      {d.faq.length > 0 && (
        <section class="faq" aria-labelledby="faq-title">
          <h2 id="faq-title">{ui.faq}</h2>
          {d.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )}

      <footer class="post-foot">
        <p class="meta">{lang === 'de' ? 'Mehr Eindrücke auf Instagram:' : 'More on Instagram:'} <a href={SITE.instagram} rel="noopener" target="_blank">{SITE.instagramHandle}</a></p>
      </footer>
    </div>
  </article>

  {related.length > 0 && (
    <section class="wrap section" aria-labelledby="related-title">
      <div class="section-head"><h2 id="related-title">{ui.related}</h2></div>
      <div class="grid grid--3">{related.map((p) => <PostCard post={p} />)}</div>
    </section>
  )}
  <Newsletter lang={lang} />
</Base>

<style>
  .post-head { max-width: calc(860px + 2 * var(--gutter)); text-align: center; padding-block: clamp(2rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem); display: grid; gap: 1.25rem; justify-items: center; }
  .post-head h1 { font-size: var(--step-5); line-height: 1.04; }
  .post-head .lead { color: var(--muted); max-width: 40rem; }
  .post-head .breadcrumbs { margin-bottom: 0.5rem; }
  .post-hero { margin: 0 auto clamp(2.5rem, 5vw, 4rem); max-width: var(--max); }
  .post-hero img { width: 100%; max-height: 82vh; object-fit: cover; }
  @media (min-width: 1241px) { .post-hero { padding-inline: var(--gutter); } }

  .disclosure { font-size: 0.9rem; color: var(--muted); border-left: 2px solid var(--gold-soft); padding: 0.25rem 0 0.25rem 1rem; margin-bottom: 2.5rem; }
  .disclosure strong { color: var(--text); font-weight: 600; }

  .places, .faq { margin-top: clamp(3rem, 6vw, 4.5rem); }
  .places h2, .faq h2 { font-size: var(--step-3); padding-bottom: 1rem; border-bottom: 1px solid var(--text); }
  .places ul { list-style: none; padding: 0; margin: 0; }
  .place { padding-block: 1.75rem; border-bottom: 1px solid var(--line); scroll-margin-top: 90px; }
  .place__head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .place h3 { font-size: var(--step-2); }
  .place__price { color: var(--accent); letter-spacing: 0.1em; font-size: 0.85rem; }
  .place__summary { color: var(--muted); margin-top: 0.4rem; }
  dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.9rem 1.5rem; margin: 1.25rem 0 0; font-size: 0.93rem; }
  dt { font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
  dd { margin: 0.15rem 0 0; }
  .place__links { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: 1.25rem; font-size: 0.9rem; font-weight: 500; }

  details { border-bottom: 1px solid var(--line); }
  summary {
    cursor: pointer; list-style: none; padding: 1.25rem 2rem 1.25rem 0; position: relative;
    font-family: var(--serif); font-size: var(--step-1);
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 0; top: 1.1rem; font-family: var(--sans); font-size: 1.4rem; font-weight: 300; transition: transform 0.3s var(--ease); }
  details[open] summary::after { transform: rotate(45deg); }
  details p { padding-bottom: 1.5rem; color: #3a3833; }
  .post-foot { margin-top: 3rem; }
</style>
